+  STD_TORCH_CHECK(
+      forced_tile_n != -1,
+      "VLLM_SM120_BLOCKWISE_FP8_SWAPAB_TILE_N must be 8, 16, or 32");
+  if (forced_tile_n != 0) {
+    return static_cast<Sm120BlockwiseFp8SwapABTileN>(forced_tile_n);
+  }
+
