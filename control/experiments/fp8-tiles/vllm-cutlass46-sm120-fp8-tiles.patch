+inline int forced_sm120_blockwise_fp8_swapab_tile_n() {
+  static const int forced_tile_n = [] {
+    const char* value =
+        std::getenv("VLLM_SM120_BLOCKWISE_FP8_SWAPAB_TILE_N");
+    if (value == nullptr || value[0] == '\0') {
