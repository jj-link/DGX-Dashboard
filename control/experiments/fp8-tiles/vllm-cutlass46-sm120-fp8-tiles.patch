+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace vllm {
+
+struct Sm120BlockwiseFp8Tactic {
+  int32_t m;
+  int32_t n;
+  int32_t k;
+  int32_t tile_n;
+};
+
+// Generated by experiments/fp8-tiles/tune_fp8_tiles.py. The empty table keeps
+// the existing tile-N=32 behavior until measurements are generated and applied.
+inline constexpr std::array<Sm120BlockwiseFp8Tactic, 0>
+    kSm120BlockwiseFp8SwapABTactics = {};
+
+}  // namespace vllm
