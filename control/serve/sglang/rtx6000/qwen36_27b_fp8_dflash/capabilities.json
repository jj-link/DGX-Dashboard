{
  "schema_version": 1,
  "api": "openai-completions",
  "input": ["text"],
  "max_output_tokens": 131072,
  "tools": {
    "supported": true,
    "parallel": true
  },
  "reasoning": {
    "supported": true,
    "can_disable": true,
    "levels": ["high"],
    "default": "high",
    "request_format": "qwen-chat-template",
    "response_field": "reasoning_content"
  }
}
