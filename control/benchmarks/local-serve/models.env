#!/usr/bin/env bash
# Local model registry for RTX PRO 6000 Blackwell (this WSL2 box).
# Each alias maps to:
#   LSERVE_MODEL        — model path or HF repo id
#   LSERVE_NAME         — short --served-model-name; what clients pass as "model"
#   LSERVE_MAX_LEN      — vLLM --max-model-len
#   LSERVE_REASONING    — --reasoning-parser
#   LSERVE_TOOL_PARSER  — --tool-call-parser
#   LSERVE_KV_CACHE     — --kv-cache-dtype
#   LSERVE_TOKENIZER    — optional tokenizer override (for the broken NVFP4 repos)
#   LSERVE_EXTRA        — extra vLLM args

select_local_model() {
  local alias="$1"
  LSERVE_TOKENIZER=""
  LSERVE_REASONING=""
  LSERVE_TOOL_PARSER=""
  LSERVE_KV_CACHE=""
  LSERVE_SCRIPT=""
  case "$alias" in
    lfm25-8b-a1b-prismaquant-65bit)
      LSERVE_SCRIPT="serve/vllm/serve_lfm25_8b_a1b_prismaquant_65bit.sh"
      LSERVE_MODEL="rdtand/LFM2.5-8B-A1B-PrismaQuant-6.5bit-vllm"
      LSERVE_NAME="LFM2.5-8B-A1B-PrismaQuant-6.5bit"
      LSERVE_MAX_LEN="128000"
      LSERVE_TOOL_PARSER="lfm2"
      LSERVE_KV_CACHE="auto"
      LSERVE_EXTRA="--quantization compressed-tensors"
      ;;
    qwen36-27b-nvfp4)
      LSERVE_SCRIPT="serve/vllm/serve_qwen36_nvfp4_base.sh"
      # unsloth NVFP4 (replaces the rejected sakamakismile -mtp-fixed local
      # symlink dir). Its tokenizer_class=TokenizersBackend isn't recognized,
      # so override with the cached official FP8 sibling tokenizer (the bf16
      # base Qwen/Qwen3.6-27B is not cached locally; the FP8 one is).
      LSERVE_MODEL="unsloth/Qwen3.6-27B-NVFP4"
      LSERVE_NAME="qwen36-27b-nvfp4"
      LSERVE_MAX_LEN="131072"
      LSERVE_REASONING="qwen3"
      LSERVE_TOOL_PARSER="qwen3_xml"
      LSERVE_TOKENIZER="Qwen/Qwen3.6-27B-FP8"
      LSERVE_EXTRA=""
      ;;
    qwen36-27b-fp8)
      LSERVE_SCRIPT="serve/vllm/serve_qwen36_27b_fp8.sh"
      LSERVE_MODEL="Qwen/Qwen3.6-27B-FP8"
      LSERVE_NAME="qwen36-27b-fp8"
      LSERVE_MAX_LEN="131072"
      LSERVE_REASONING="qwen3"
      LSERVE_TOOL_PARSER="qwen3_xml"
      LSERVE_EXTRA=""
      ;;
    qwen36-35b-a3b-nvfp4)
      LSERVE_SCRIPT="serve/vllm/serve_qwen36_a3b_nvfp4.sh"
      LSERVE_MODEL="RedHatAI/Qwen3.6-35B-A3B-NVFP4"
      LSERVE_NAME="qwen36-35b-a3b-nvfp4"
      LSERVE_MAX_LEN="131072"
      LSERVE_REASONING="qwen3"
      LSERVE_TOOL_PARSER="qwen3_xml"
      LSERVE_TOKENIZER="Qwen/Qwen3.6-35B-A3B-FP8"
      LSERVE_EXTRA=""
      ;;
    qwen36-35b-a3b-fp8)
      LSERVE_SCRIPT="serve/vllm/serve_qwen36_a3b_fp8.sh"
      LSERVE_MODEL="Qwen/Qwen3.6-35B-A3B-FP8"
      LSERVE_NAME="qwen36-35b-a3b-fp8"
      LSERVE_MAX_LEN="131072"
      LSERVE_REASONING="qwen3"
      LSERVE_TOOL_PARSER="qwen3_xml"
      LSERVE_EXTRA=""
      ;;
    qwen36-27b-bf16)
      LSERVE_SCRIPT="serve/vllm/serve_qwen36_27b_fp8.sh"
      LSERVE_MODEL="Qwen/Qwen3.6-27B"
      LSERVE_NAME="qwen36-27b-bf16"
      LSERVE_MAX_LEN="131072"
      LSERVE_REASONING="qwen3"
      LSERVE_TOOL_PARSER="qwen3_xml"
      LSERVE_EXTRA=""
      ;;
    qwen36-35b-a3b-bf16)
      LSERVE_SCRIPT="serve/vllm/serve_qwen36_a3b_fp8.sh"
      # ~70G of bf16 weights on a 96G card — tight. If it OOMs at 131072
      # context, drop LSERVE_MAX_LEN (and MAX_TOKENS) for this alias.
      LSERVE_MODEL="Qwen/Qwen3.6-35B-A3B"
      LSERVE_NAME="qwen36-35b-a3b-bf16"
      LSERVE_MAX_LEN="131072"
      LSERVE_REASONING="qwen3"
      LSERVE_TOOL_PARSER="qwen3_xml"
      LSERVE_EXTRA=""
      ;;
    *)
      echo "unknown local alias: $alias" >&2
      return 1
      ;;
  esac
  export LSERVE_SCRIPT LSERVE_MODEL LSERVE_NAME LSERVE_MAX_LEN LSERVE_REASONING LSERVE_TOOL_PARSER LSERVE_KV_CACHE LSERVE_TOKENIZER LSERVE_EXTRA
}

# Ordered fastest → slowest so the early results land quickly. MoE 3B-active
# models go first; dense 27B last.
LOCAL_ALIASES=(qwen36-35b-a3b-fp8 qwen36-35b-a3b-nvfp4 qwen36-27b-nvfp4 qwen36-27b-fp8)
