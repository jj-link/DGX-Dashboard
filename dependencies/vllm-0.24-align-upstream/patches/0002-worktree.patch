+def is_speculative_forward() -> bool:
+    """Return whether the active model call verifies speculative tokens."""
+    if _forward_context is None:
+        return False
+
+    cache_key = "_is_speculative_forward"
+    cached = _forward_context.additional_kwargs.get(cache_key)
+    if cached is not None:
+        return bool(cached)
+
+    raw_metadata = _forward_context.attn_metadata
+    metadata_maps = raw_metadata if isinstance(raw_metadata, list) else [raw_metadata]
+    speculative = any(
+        getattr(metadata, "spec_sequence_masks", None) is not None
+        for metadata_map in metadata_maps
+        if isinstance(metadata_map, dict)
+        for metadata in metadata_map.values()
+    )
+    _forward_context.additional_kwargs[cache_key] = speculative
+    return speculative
+
