[Unit]
Description=DGX Dashboard Unified Control Plane
After=network.target

[Service]
Type=simple
User=workbench
WorkingDirectory=/home/workbench/Projects/personal/dgx-dashboard
ExecStart=/home/workbench/Projects/personal/dgx-dashboard/venv/bin/python /home/workbench/Projects/personal/dgx-dashboard/server.py
Restart=on-failure
UMask=0027
KillMode=control-group
TimeoutStopSec=45
RestartSec=5
Environment=PATH=/home/workbench/.local/bin:/usr/lib/wsl/lib:/usr/bin:/bin
Environment=DASHBOARD_CONFIG=/var/lib/dgx-dashboard/config-production.ini
Environment=TMPDIR=/var/lib/dgx-dashboard/tmp
EnvironmentFile=-/var/lib/dgx-dashboard/dashboard.env
StateDirectory=dgx-dashboard
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/dgx-dashboard

[Install]
WantedBy=default.target
